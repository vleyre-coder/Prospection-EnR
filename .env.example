# Configuration de l'application de prospection ENR.
#
#   cp .env.example .env
#
# AUCUNE variable n'est obligatoire. Sans .env, l'application applique ses migrations,
# genere son secret de signature, cree un compte administrateur et charge les donnees
# nationales manquantes a son premier demarrage. Ce fichier ne sert qu'a regler ce que
# vous voulez maitriser.

# ============================================================================
#  LES SEULES LIGNES QUI COMPTENT POUR UNE MISE EN SERVICE SIMPLE
# ============================================================================

# Identifiants d'administration. Renseignez les deux pour choisir vos acces.
# Laissez vides : un compte est cree au premier demarrage et son mot de passe est
# affiche dans les journaux (docker compose logs api / ./demarrer.sh --journaux).
# Le mot de passe doit compter au moins 12 caracteres.
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=

# Ports exposes par la pile Docker.
PORT_WEB=8080
PORT_API=3000
PORT_BDD=5432

# Mot de passe PostgreSQL de la pile Docker. A changer pour un serveur partage.
POSTGRES_PASSWORD=enr

# Derriere un proxy d'entreprise : les DEUX lignes sont necessaires, Node ignore
# HTTPS_PROXY sans NODE_USE_ENV_PROXY.
# HTTPS_PROXY=http://proxy.exemple.fr:3128
# NODE_USE_ENV_PROXY=1

# ============================================================================
#  DEVELOPPEMENT LOCAL (npm run dev) — inutile pour la pile Docker
# ============================================================================

DATABASE_URL=postgres://enr:enr@localhost:5432/prospection_enr
NODE_ENV=development
PORT=3000
HOTE=0.0.0.0
NIVEAU_LOG=info

# Developpement uniquement : traite toutes les requetes comme administrateur, ce qui
# evite d'avoir a se connecter. Le serveur REFUSE de servir les routes protegees si
# NODE_ENV=production.
AUTH_DESACTIVEE=true

# ============================================================================
#  REGLAGES AVANCES — les defauts conviennent dans la quasi-totalite des cas
# ============================================================================

# Secret de signature des jetons. Laisse vide : genere au premier demarrage et conserve
# en base. A definir explicitement en production (openssl rand -hex 32).
SECRET_JWT=
DUREE_TOKEN=12h
BDD_POOL_MAX=10

# Demarrage : migrations et chargement initial des donnees nationales.
# Passez AMORCAGE_AUTO a false si l'ingestion est pilotee par un ordonnanceur externe.
MIGRATIONS_AUTO=true
AMORCAGE_AUTO=true

# Interface servie par l'API des lors que apps/web/dist existe (un seul port suffit).
# SERVIR_WEB=false pour n'exposer que l'API.
SERVIR_WEB=true

# Origines autorisees a appeler l'API depuis un navigateur, separees par des virgules.
# Necessaire uniquement si l'interface est hebergee ailleurs que l'API (front statique sur
# Netlify, par exemple). Voir docs/HEBERGEMENT.md.
# ORIGINES_AUTORISEES=https://prospection-enr.netlify.app

# Appels aux sources externes. La Geoplateforme IGN limite a 1 requete/seconde :
# ne pas augmenter HTTP_CONCURRENCE sans raison.
HTTP_TIMEOUT_MS=20000
HTTP_TENTATIVES=3
HTTP_CONCURRENCE=4
HTTP_CACHE_TTL_MS=900000

# Cache et fraicheur des donnees de parcelles.
SNAPSHOT_MAX_AGE_JOURS=30
PARCELLE_MAX_AGE_JOURS=180

# Carte.
ZOOM_MIN_PARCELLES=12
ZOOM_MAX_COMMUNES=12
LIMITE_PARCELLES=3000

# Qualification a la demande. La surface minimale evite le bruit des micro-parcelles.
QUALIF_SURFACE_MIN_M2=3000
QUALIF_LOT_MAX=1500

# Repertoire des donnees volumineuses ingerees (raster de vent).
REPERTOIRE_DONNEES=data
