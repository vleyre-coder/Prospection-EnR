# --- Base de donnees --------------------------------------------------------
DATABASE_URL=postgres://enr:enr@localhost:5432/prospection_enr
POSTGRES_PASSWORD=enr
BDD_POOL_MAX=10

# --- Serveur ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOTE=0.0.0.0
NIVEAU_LOG=info

# --- Authentification -------------------------------------------------------
# En developpement uniquement : traite toutes les requetes comme administrateur.
# Le serveur REFUSE de servir les routes protegees si NODE_ENV=production.
AUTH_DESACTIVEE=true
# Obligatoire en production. Generer avec : openssl rand -hex 32
SECRET_JWT=changez-ce-secret-en-production
DUREE_TOKEN=12h

# --- Compte administrateur cree par `npm run db:seed` -----------------------
ADMIN_EMAIL=admin@prospection-enr.local
# Au moins 12 caracteres. Sans cette variable, aucun compte n'est cree.
ADMIN_MOT_DE_PASSE=

# --- Reseau -----------------------------------------------------------------
# Derriere un proxy d'entreprise, renseigner HTTPS_PROXY et activer sa prise en compte
# par Node : NODE_USE_ENV_PROXY=1 (Node >= 22). Sans cette variable, Node ignore
# HTTPS_PROXY et certaines sources deviennent injoignables.
# HTTPS_PROXY=http://proxy.exemple.fr:3128
# NODE_USE_ENV_PROXY=1

# --- Appels aux sources externes -------------------------------------------
HTTP_TIMEOUT_MS=20000
HTTP_TENTATIVES=3
# La Geoplateforme IGN limite a 1 requete/seconde : ne pas augmenter sans raison.
HTTP_CONCURRENCE=4
HTTP_CACHE_TTL_MS=900000

# --- Cache et fraicheur -----------------------------------------------------
SNAPSHOT_MAX_AGE_JOURS=30
PARCELLE_MAX_AGE_JOURS=180

# --- Carte ------------------------------------------------------------------
ZOOM_MIN_PARCELLES=14
ZOOM_MAX_COMMUNES=13
LIMITE_PARCELLES=3000

# --- Qualification a la demande --------------------------------------------
# Surface minimale d'une parcelle qualifiee, en m2 : evite le bruit des micro-parcelles.
QUALIF_SURFACE_MIN_M2=3000
QUALIF_LOT_MAX=300
