    "@fastify/static": "^8.0.3",
    "@types/pdfkit": "^0.17.6",
    "fastify": "^5.2.0",
    "geotiff": "^3.0.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
